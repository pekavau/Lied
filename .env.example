# Copy to .env and fill in real values for local development.
# Never commit the real .env file.

POSTGRES_USER=lied
POSTGRES_PASSWORD=lied
POSTGRES_DB=lied

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

LIED_S3_BUCKET=lied

# HS256 signing secret for bearer JWTs (32+ random bytes recommended).
# In production, prefer LIED_JWT_SIGNING_KEY_FILE pointing at a secret file,
# or LIED_JWT_SIGNING_KEY_CMD shelling out to a secret manager (e.g. `pass`,
# `op read`, `vault kv get`).
LIED_JWT_SIGNING_KEY=dev-only-insecure-signing-key-do-not-use-in-prod

# Toggles (see CLAUDE.md "Default limits" table).
LIED_METRICS_ENABLED=false
LIED_DOCS_ENABLED=true
LIED_TRACING_PRETTY=true
