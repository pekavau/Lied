{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            o.id   AS organization_id,\n            o.name AS organization_name,\n            o.slug AS organization_slug,\n            m.role AS role,\n            m.is_principal AS is_principal\n        FROM membership m\n        JOIN organization o ON o.id = m.organization_id\n        WHERE m.user_id = $1\n        ORDER BY o.name ASC, o.id ASC\n        ",
