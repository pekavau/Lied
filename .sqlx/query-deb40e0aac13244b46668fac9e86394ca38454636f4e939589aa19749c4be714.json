  "query": "\n        SELECT u.username as \"username!\"\n        FROM membership m\n        JOIN \"user\" u ON u.id = m.user_id\n        WHERE m.organization_id = $1\n        ORDER BY u.username ASC\n        LIMIT $2\n        ",
