{
  "db_name": "PostgreSQL",
  "query": "\n        UPDATE organization\n        SET name = $2, updated_at = now()\n        WHERE id = $1 AND ($3::bigint IS NULL OR floor(extract(epoch FROM updated_at) * 1000)::bigint = $3)\n        RETURNING\n            id, name, slug,\n            created_at as \"created_at: DateTime<Utc>\",\n            updated_at as \"updated_at: DateTime<Utc>\"\n        ",
